flowchart TB
    L1["L1 单次内反思<br/>触发 阶段失败或当场反驳<br/>落点 工作记忆不落库<br/>闸门 自动"]
    L2["L2 交付后复盘<br/>触发 报告交付加人工终审<br/>落点 该客户情节记忆<br/>闸门 自动加抽检"]
    L3["L3 跨客户沉淀<br/>触发 每 10 次诊断或月度<br/>落点 语义层加经验库<br/>闸门 分级"]
    L4["L4 真值校准<br/>触发 落地结果回填<br/>落点 程序记忆 版本化<br/>闸门 人工必过"]

    L1 --> L2 --> L3 --> L4

    subgraph ROLE["三角色上下文隔离"]
        E["执行者 跑六阶段"]
        RF["反思者 只看轨迹与结果<br/>不看执行者推理链"]
        CU["策展者 唯一写库角色<br/>只裁决不产生新经验"]
    end
    E --> RF --> CU

    CU --> ST["经验库状态机<br/>草稿 试用 生效 陈旧 被取代 退役"]

    subgraph GATE["防退化四道闸"]
        G1["配额淘汰 上限 150 条<br/>反例 2 次转试用 3 次退役"]
        G2["试用期 累计 5 次无反例转生效"]
        G3["冻结黄金集 12 例<br/>任一维度回退超 5% 回滚"]
        G4["冲突检测 对立策略转人工<br/>不允许最新覆盖最旧"]
    end
    ST --> GATE
    GATE -->|"通过"| ACT["条目生效 参与检索"]
    GATE -->|"拒绝"| RB["整批回滚"]

    classDef gate fill:#fee2e2,stroke:#b91c1c,color:#0f172a
    classDef ok fill:#dcfce7,stroke:#15803d,color:#0f172a
