flowchart TB
    subgraph IN["五路取证"]
        R1["R1 时间戳导出 A 级<br/>唯一主力"]
        R4["R4 工时记录 A 级<br/>仅高价值场景"]
        R2["R2 轻量补数表 B 级<br/>R1 拿不到时启用"]
        R3["R3 多方交叉 B 级<br/>默认叠加"]
        R5["R5 会议纪要 C 级<br/>禁止用于量化"]
    end

    ADJ["固定序裁决<br/>时间戳导出 大于 工时记录 大于 补数表<br/>大于 多方交叉 大于 单方自述"]
    R1 --> ADJ
    R4 --> ADJ
    R2 --> ADJ
    R3 --> ADJ
    R5 --> ADJ

    ADJ --> Q{"三路结论偏差<br/>是否超过 30%"}
    Q -->|"超过"| H["强制标注冲突<br/>转人工<br/>不取均值"]
    Q -->|"未超过"| K["按优先序采信高等级路径"]

    K --> W{"作业形态判定<br/>时间窗聚集性"}
    W -->|"单次大于等于 30 分钟"| W1["连续 折现 1.0"]
    W -->|"同窗聚集合计大于等于 30 分钟"| W2["批量 折现 1.0"]
    W -->|"分散无聚集"| W3["真碎片 折现 0<br/>不进 ROI"]
    W -->|"时间戳与自述皆无"| W4["按真碎片处理<br/>报告注明可上调空间"]

    classDef a fill:#dcfce7,stroke:#15803d,color:#0f172a
    classDef c fill:#fee2e2,stroke:#b91c1c,color:#0f172a
    class R1,R4,W1,W2 a
    class R5,H,W3 c
