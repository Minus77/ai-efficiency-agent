flowchart TB
    IN["顾问请求与客户材料"]
    G1["1 输入校验<br/>越权数据请求拦截 个人信息扫描 越狱检测"]
    G2["2 推理校验<br/>阶段跃迁校验 证据不足不许进 S4"]
    G3["3 工具入参<br/>结构校验 只读断言 租户归属校验"]
    T["工具执行 15 个工具 全部只读"]
    G4["4 工具出参<br/>注入检测 个人信息脱敏 超长截断"]
    G5["5 最终输出<br/>无证据声明拦截 客户机密泄漏检查"]
    OUT["报告与视图"]

    G6["6 规则层 全是代码不是模型<br/>阶段步数上限 20<br/>会话 6 美元 每小时 20 美元<br/>反评审最多 3 轮 检索速率配额"]
    G7["7 守护 Agent 独立观察者<br/>对结论超出证据强度有否决权"]

    IN --> G1 --> G2 --> G3 --> T --> G4 --> G5 --> OUT
    G6 -.->|"超限即挂起加告警加落轨迹<br/>不静默降级"| T
    G7 -.->|"否决"| G5

    FROZEN["冻结区 运行时不可写<br/>证据口径 ROI 公式 只读边界<br/>裁决序 冲突阈值 0.30 折现规则"]
    FROZEN -.->|"Agent 无任何工具可改"| G6

    classDef guard fill:#fee2e2,stroke:#b91c1c,color:#0f172a
    classDef frozen fill:#e0e7ff,stroke:#4338ca,color:#0f172a
    class G1,G2,G3,G4,G5,G6,G7 guard
    class FROZEN frozen
